// schema.prisma
// --------------------------------------------------
// 對應我們的後端 index.js 所需的完整資料模型
// DB: PostgreSQL（請用 DATABASE_URL 指向你的 carparts 資料庫）
// --------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 新增供應模式枚舉（enum），強制約束 availability_mode 值
enum AvailabilityMode {
  STOCK
  LEAD
  MTO
}

/////////////////////////////////////////////////////
// 車型結構：品牌 → 車系 → 世代 → 車型變體
/////////////////////////////////////////////////////

model makes {
  id      Int      @id @default(autoincrement())
  name    String   @unique
  models  models[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model models {
  id       Int     @id @default(autoincrement())
  make_id  Int
  name     String

  makes    makes   @relation(fields: [make_id], references: [id])
  generations generations[]
  vehicle_variants vehicle_variants[]

  @@index([make_id])
  @@unique([make_id, name])

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model generations {
  id        Int    @id @default(autoincrement())
  model_id  Int
  name      String?
  year_from Int
  year_to   Int

  models    models @relation(fields: [model_id], references: [id])
  vehicle_variants vehicle_variants[]

  @@index([model_id])
  @@index([year_from, year_to])

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model vehicle_variants {
  id            Int     @id @default(autoincrement())
  model_id      Int
  generation_id Int?
  name          String?
  engine_code   String?
  year_from     Int
  year_to       Int
  displacement_cc Int?
  power_ps        Int?
  intake_type     String?
  drive_type      String?
  front_suspension String?
  rear_suspension  String?
  fuel_type       String?

  // 注意：關聯欄位名稱要與 index.js 使用的 include 一致（models / generations）
  models      models      @relation(fields: [model_id], references: [id])
  generations generations? @relation(fields: [generation_id], references: [id])

  part_compatibilities part_compatibilities[]

  @@index([model_id])
  @@index([generation_id])
  @@index([year_from, year_to])

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

/////////////////////////////////////////////////////
// 零件 / 類別 / 相容車型
/////////////////////////////////////////////////////

model parts {
  id             Int     @id @default(autoincrement())
  sku            String  @unique
  name           String
  brand          String?
  category       String?      // 前台相容，仍保留主分類名稱字串（舊欄位，建議逐步棄用）
  msrp_twd       Int?    @default(null)
  wholesale_twd  Int?    @default(null)
  currency       String  @default("TWD")
  weight_kg      Float?
  vat_included   Boolean @default(true)
  stock_qty      Int     @default(0)
  availability_mode AvailabilityMode?
  lead_time_days Int?
  image_url      String?
  description    String?

  parts_on_categories parts_on_categories[]
  part_compatibilities part_compatibilities[]
  order_items         order_items[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model categories {
  id         Int          @id @default(autoincrement())
  name       String
  slug       String       @unique
  parent_id  Int?
  parent     categories?  @relation("CatParent", fields: [parent_id], references: [id])
  children   categories[] @relation("CatParent")

  sort_order Int          @default(0)
  is_active  Boolean      @default(true)
  is_nav     Boolean      @default(true)

  parts_on_categories parts_on_categories[]

  @@index([parent_id])
  @@index([is_active])
}

model parts_on_categories {
  id          Int        @id @default(autoincrement())
  part_id     Int
  category_id Int
  is_primary  Boolean    @default(false)

  parts      parts      @relation(fields: [part_id], references: [id])
  categories categories @relation(fields: [category_id], references: [id])

  @@index([part_id])
  @@index([category_id])
  @@unique([part_id, category_id]) // 防止重複掛同一分類
}

model part_compatibilities {
  id                 Int               @id @default(autoincrement())
  part_id            Int
  vehicle_variant_id Int
  note               Json?             // 允許 JSON 格式的額外註記，例如 { "position": "front wishbone" }

  parts            parts            @relation(fields: [part_id], references: [id])
  vehicle_variants vehicle_variants @relation(fields: [vehicle_variant_id], references: [id])

  @@index([part_id])
  @@index([vehicle_variant_id])
  @@unique([part_id, vehicle_variant_id]) // 防止重複相容關聯
}

/////////////////////////////////////////////////////
// 訂單（擴充 buyer/shipping 欄位，支援 Checkout 表單）
/////////////////////////////////////////////////////

model orders {
  id              Int       @id @default(autoincrement())
  order_no        String    @unique
  status          String    @default("draft")
  buyer           Json?     // 購買者資訊 JSON，例如 { "company_name": "...", "buyer_name": "...", "phone": "...", "email": "...", "tax_id": "..." }
  shipping_address String?
  shipping_twd    Int?      @default(0)
  total_twd       Int?      // 自動計算總額（subtotal + shipping）
  note            String?

  order_items order_items[]

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
}

model order_items {
  id             Int     @id @default(autoincrement())
  order_id       Int
  part_id        Int
  qty            Int     @default(1)
  unit_price_twd Int?

  orders orders @relation(fields: [order_id], references: [id])
  parts  parts  @relation(fields: [part_id], references: [id])

  @@index([order_id])
  @@index([part_id])
}