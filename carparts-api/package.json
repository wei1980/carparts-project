{
  "name": "carparts-api",
  "version": "1.0.0",
  "description": "Car parts API (Express + Prisma + PostgreSQL)",
  "main": "index.js",
  "license": "MIT",
  "scripts": {
    "import:vehicles": "node prisma/importVehicles.js ./data/vehicles.csv",
    "import:parts": "node prisma/importParts.js ./data/parts.csv ./data/compatibilities.csv",
    "start": "node index.js",
    "dev": "node index.js",
    "seed": "node prisma/seed.js",
    "seed:categories": "node prisma/seed_categories.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init_app",
    "prisma:reset": "prisma migrate reset -f"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "axios": "^1.12.2",
    "bottleneck": "^2.19.5",
    "cheerio": "^1.1.2",
    "cors": "^2.8.5",
    "csv-parse": "^5.6.0",
    "csv-parser": "^3.2.0",
    "csv-writer": "^1.6.0",
    "dotenv": "^17.2.3",
    "express": "^4.19.2",
    "iconv-lite": "^0.7.0",
    "multer": "^2.0.2",
    "papaparse": "^5.5.3",
    "robots-parser": "^3.0.1"
  },
  "devDependencies": {
    "prisma": "^5.22.0"
  },
  "engines": {
    "node": ">=18"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
