{
  "name": "carparts-api",
  "version": "1.0.0",
  "description": "Car parts API (Express + Prisma + PostgreSQL)",
  "main": "src/server.js",
  "license": "MIT",
  "scripts": {
    "import:vehicles": "node prisma/importVehicles.js ./data/vehicles.csv",
    "import:parts": "node prisma/importParts.js ./data/parts.csv ./data/compatibilities.csv",
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node prisma/seed.js",
    "seed:categories": "node prisma/seed_categories.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init_app",
    "prisma:reset": "prisma migrate reset -f",
    "test": "node scripts/run-node-tests.cjs",
    "test:watch": "node scripts/run-node-tests.cjs --watch",
    "test:coverage": "node scripts/run-node-tests.cjs --experimental-test-coverage",
    "lint": "oxlint",
    "swagger:generate": "node swaggerAutogen.js"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@sentry/node": "^10.73.0",
    "@sentry/profiling-node": "^10.73.0",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "bottleneck": "^2.19.5",
    "bullmq": "^6.3.1",
    "cheerio": "^1.1.2",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "csurf": "^1.11.0",
    "csv-parse": "^5.6.0",
    "csv-parser": "^3.2.0",
    "csv-writer": "^1.6.0",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^4.22.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "iconv-lite": "^0.7.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "node-cron": "^4.6.0",
    "papaparse": "^5.5.3",
    "puppeteer-core": "^25.7.0",
    "react-hot-toast": "^2.6.0",
    "robots-parser": "^3.0.1",
    "sharp": "^0.35.3",
    "swagger-autogen": "^2.23.7",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0",
    "winston-elasticsearch": "^0.19.0",
    "winston-loki": "^6.1.7"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@babel/preset-env": "^8.0.2",
    "@types/jest": "^30.0.0",
    "@types/supertest": "^7.2.1",
    "babel-jest": "^30.5.1",
    "jest": "^30.5.1",
    "nodemon": "^3.1.14",
    "oxlint": "^1.75.0",
    "prisma": "^5.22.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "xlsx": "^0.18.5"
  },
  "engines": {
    "node": ">=18"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "prisma@5.22.0": true,
    "unrs-resolver@1.12.2": true
  }
}
