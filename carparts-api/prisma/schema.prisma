// schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

// =========================================
// Enums
// =========================================

enum SupplyStatus {
  IN_STOCK      // 現貨
  PREORDER      // 預訂 (庫存=0)
  DISCONTINUED  // 停產/缺貨
}

enum OrderStatus {
  PENDING_PAYMENT // 待付款 (已扣庫存)
  PAYMENT_REVIEW  // 待查核 (已填後五碼)
  PAID            // 已付款 (對帳成功/訂金已付)
  SHIPPED         // 已出貨
  COMPLETED       // 已完成
  CANCELLED       // 已取消 (歸還庫存)
}

enum WorkshopRole {
  TRIAL     // 試用會員 (限制次數, 僅看 MSRP)
  VERIFIED  // 正式會員 (可看批發價, 可下單)
  ADMIN     // 平台管理員
}

// =========================================
// Models
// =========================================

// 1. 車廠/使用者 (Workshops)
model Workshop {
  id              Int          @id @default(autoincrement())
  email           String       @unique
  password_hash   String
  company_name    String
  tax_id          String?      
  line_id         String       
  contact_person  String
  phone           String
  address         String
  
  role            WorkshopRole @default(TRIAL)
  
  // 審核狀態
  is_approved     Boolean      @default(false)
  is_active       Boolean      @default(true)
  
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt

  orders          Order[]
  query_usage     WorkshopQueryUsage[]

  @@map("workshops")
}

// 2. 核心車型資料庫 (Vehicle Variants)
model VehicleVariant {
  id            Int     @id @default(autoincrement())
  
  // 階層資料
  make          String  
  model         String  
  generation    String  
  engine_code   String  
  
  variant_name  String  
  specs         Json?   
  
  year_start    Int
  year_end      Int

  compatible_parts PartCompatibility[]

  @@index([make, model, generation, year_start])
  @@map("vehicle_variants")
}

// 3. 分類系統 (Categories) - 新增
model Categories {
  id            Int             @id @default(autoincrement())
  name          String
  sort_order    Int             @default(0)
  is_active     Boolean         @default(true)
  
  subcategories Subcategories[]
  parts_link    PartsOnCategories[]

  @@map("categories")
}

// 4. 子分類 (Subcategories) - 新增
model Subcategories {
  id            Int      @id @default(autoincrement())
  category_id   Int
  name          String
  sort_order    Int      @default(0)
  is_active     Boolean  @default(true)
  
  category      Categories @relation(fields: [category_id], references: [id])
  parts         Part[]

  @@index([category_id])
  @@map("subcategories")
}

// 5. 零件主表 (Parts)
model Part {
  id                      Int              @id @default(autoincrement())
  sku                     String           @unique
  name                    String
  brand                   String
  
  // 關聯分類
  subcategory_id          Int?
  subcategory             Subcategories?   @relation(fields: [subcategory_id], references: [id])
  
  // 搜尋用快取欄位 (配合 index.js 搜尋邏輯)
  category                String?          

  image_url               String?
  description             String?
  
  // 價格
  msrp_price              Decimal          @default(0)
  wholesale_price         Decimal          @default(0)
  
  // 庫存與供應鏈
  stock_qty               Int              @default(0) 
  preorder_lead_time_days Int              @default(21)
  
  is_active               Boolean          @default(true)
  
  created_at              DateTime         @default(now())
  updated_at              DateTime         @updatedAt

  // 關聯
  compatible_vehicles     PartCompatibility[]
  order_items             OrderItem[]
  parts_on_categories     PartsOnCategories[]

  @@index([subcategory_id])
  @@map("parts")
}

// 6. 零件與分類多對多關聯 (PartsOnCategories) - 新增
model PartsOnCategories {
  part_id     Int
  category_id Int
  part        Part       @relation(fields: [part_id], references: [id])
  category    Categories @relation(fields: [category_id], references: [id])
  
  @@id([part_id, category_id])
  @@index([category_id])
  @@index([part_id])
  @@map("parts_on_categories")
}

// 7. 零件與車型關聯 (Many-to-Many)
model PartCompatibility {
  id            Int @id @default(autoincrement())
  part_id       Int
  vehicle_id    Int
  
  part          Part           @relation(fields: [part_id], references: [id])
  vehicle       VehicleVariant @relation(fields: [vehicle_id], references: [id])

  @@unique([part_id, vehicle_id])
  @@index([vehicle_id])
  @@map("part_vehicle_compatibility")
}

// 8. 訂單主表 (Orders)
model Order {
  id                    Int         @id @default(autoincrement())
  order_number          String      @unique 
  workshop_id           Int
  status                OrderStatus @default(PENDING_PAYMENT)
  
  subtotal_amount       Decimal
  shipping_fee          Decimal     @default(0)
  total_amount          Decimal
  
  payment_last_5_digits String?     
  deposit_required      Boolean     @default(false)
  
  shipping_address      String
  tracking_number       String?

  created_at            DateTime    @default(now())
  updated_at            DateTime    @updatedAt

  workshop              Workshop    @relation(fields: [workshop_id], references: [id])
  items                 OrderItem[]

  @@map("orders")
}

// 9. 訂單明細
model OrderItem {
  id              Int     @id @default(autoincrement())
  order_id        Int
  part_id         Int
  
  sku_snapshot    String
  name_snapshot   String
  price_snapshot  Decimal 
  
  qty             Int
  is_preorder     Boolean @default(false)
  promised_weeks  Int     @default(0)     

  order           Order   @relation(fields: [order_id], references: [id])
  part            Part    @relation(fields: [part_id], references: [id])

  @@index([order_id])
  @@map("order_items")
}

// 10. 查詢配額紀錄
model WorkshopQueryUsage {
  id            Int      @id @default(autoincrement())
  workshop_id   Int
  year_month    String   
  query_count   Int      @default(0)
  rows_returned Int      @default(0) // 新增欄位配合 index.js
  last_query_at DateTime? @default(now()) // 新增欄位配合 index.js
  
  updated_at    DateTime @updatedAt

  workshop      Workshop @relation(fields: [workshop_id], references: [id])

  @@unique([workshop_id, year_month])
  @@map("workshop_query_usage")
}