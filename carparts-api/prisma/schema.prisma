// ---------- Prisma Client ----------
generator client {
  provider = "prisma-client-js"
}

// ---------- Database ----------
datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  // 使用 Prisma relation 模式（不建外鍵），我們會手動加索引以維持查詢效能
  relationMode = "prisma"
}

// ---------- Enums ----------
enum AvailabilityMode {
  stock // 現貨（24–48 小時內出貨）
  preorder // 預訂（顯示備貨天數）
}

enum SupplyStatus {
  IN_STOCK
  PREORDER
  DISCONTINUED
}

enum WorkshopRole {
  ADMIN
  WORKSHOP_OWNER
  STAFF
}

enum WorkshopSpecialty {
  EURO_BMW_MBENZ
  JP_TOYOTA
  DOMESTIC
  EV_TESLA
  PERFORMANCE
  OTHER
}

// ---------- Tables / Models ----------
model parts {
  id                Int               @id @default(autoincrement())
  sku               String            @unique
  name              String
  brand             String?
  brand_id          Int?
  category          String? // 舊主分類字串（仍保留，建議逐步改為 parts_on_categories 關聯）
  msrp_twd          Int?
  wholesale_twd     Int?
  msrp              Int?
  wholesale_price   Int?
  image_url         String?
  description       String?
  stock_qty         Int               @default(0)
  availability_mode AvailabilityMode?
  lead_time_days    Int               @default(0)
  supply_status     SupplyStatus?
  preorder_days     Int               @default(21)
  subcategory_id    Int?
  is_active         Boolean           @default(true)
  created_at        DateTime          @default(now())
  updated_at        DateTime          @updatedAt

  // relations
  parts_on_categories  parts_on_categories[]
  part_compatibilities part_compatibilities[]
  brand_ref            brands?                @relation(fields: [brand_id], references: [id])
  subcategory          subcategories?         @relation(fields: [subcategory_id], references: [id])

  // 適度輔助查詢的索引（選配）
  @@index([name])
  @@index([brand])
  @@index([category])
  @@index([brand_id])
  @@index([subcategory_id])
  @@map("parts")
}

model categories {
  id         Int     @id @default(autoincrement())
  name       String
  slug       String?
  sort_order Int     @default(0)
  is_active  Boolean @default(true)
  is_nav     Boolean @default(true)

  // relations
  subcategories       subcategories[]
  parts_on_categories parts_on_categories[]

  // 供分類樹與清單排序使用的索引
  @@index([is_active])
  @@map("categories")
}

model subcategories {
  id          Int     @id @default(autoincrement())
  category_id Int
  name        String
  slug        String?
  sort_order  Int     @default(0)
  is_active   Boolean @default(true)

  // relations
  category categories @relation(fields: [category_id], references: [id])
  parts    parts[]

  @@unique([category_id, name], name: "ux_category_subcategory_name")
  @@index([category_id])
  @@index([is_active])
  @@map("subcategories")
}

model parts_on_categories {
  id          Int @id @default(autoincrement())
  part_id     Int
  category_id Int

  // relations（relationMode=prisma 下不建外鍵，因此靠索引輔助）
  part     parts      @relation(fields: [part_id], references: [id])
  category categories @relation(fields: [category_id], references: [id])

  // 去重
  @@unique([part_id, category_id], name: "ux_part_category")
  // 查詢效能用索引（重要）
  @@index([part_id])
  @@index([category_id])
  @@map("parts_on_categories")
}

model makes {
  id   Int    @id @default(autoincrement())
  name String

  // relations
  models models[]

  @@index([name])
  @@map("makes")
}

model models {
  id      Int    @id @default(autoincrement())
  name    String
  make_id Int

  // relations
  make             makes              @relation(fields: [make_id], references: [id])
  generations      generations[]
  vehicle_variants vehicle_variants[]

  // 關聯欄位索引（重要）
  @@index([make_id])
  @@index([name])
  @@map("models")
}

model generations {
  id        Int     @id @default(autoincrement())
  model_id  Int
  name      String?
  year_from Int?
  year_to   Int?

  // relations
  model            models             @relation(fields: [model_id], references: [id])
  vehicle_variants vehicle_variants[]

  // 關聯欄位索引（重要）
  @@index([model_id])
  @@index([year_from, year_to])
  @@map("generations")
}

model vehicle_variants {
  id            Int     @id @default(autoincrement())
  model_id      Int
  generation_id Int?
  name          String?
  engine_code   String?
  year_from     Int?
  year_to       Int?
  fuel_type     String?
  displacement  Int?
  power_hp      Int?
  drivetrain    String?
  transmission  String?

  // relations
  model                models                 @relation(fields: [model_id], references: [id])
  generation           generations?           @relation(fields: [generation_id], references: [id])
  part_compatibilities part_compatibilities[]

  // 關聯欄位與常用查詢索引（重要）
  @@index([model_id])
  @@index([generation_id])
  @@index([engine_code])
  @@index([year_from, year_to])
  @@map("vehicle_variants")
}

model brands {
  id         Int      @id @default(autoincrement())
  name       String
  slug       String?
  logo_url   String?
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // relations
  parts parts[]

  @@unique([slug])
  @@index([name])
  @@index([is_active])
  @@map("brands")
}

model part_compatibilities {
  id                 Int @id @default(autoincrement())
  part_id            Int
  vehicle_variant_id Int

  // relations
  part            parts            @relation(fields: [part_id], references: [id])
  vehicle_variant vehicle_variants @relation(fields: [vehicle_variant_id], references: [id])

  // 去重
  @@unique([part_id, vehicle_variant_id], name: "ux_part_variant")
  // 關聯欄位索引（重要）
  @@index([part_id])
  @@index([vehicle_variant_id])
  @@map("part_compatibilities")
}

model workshops {
  id               Int      @id @default(autoincrement())
  name             String
  tax_id           String?
  business_type    String?
  line_id          String
  mobile           String
  contact_person   String
  title            String?
  address          String
  technician_count Int?
  lift_count       Int?
  photos           Json?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  // relations
  users        users[]
  specialties  workshop_specialties[]
  plan         workshop_plans?
  query_usages workshop_query_usage[]
  status       workshop_status?

  @@index([name])
  @@index([tax_id])
  @@map("workshops")
}

model workshop_specialties {
  id          Int               @id @default(autoincrement())
  workshop_id Int
  specialty   WorkshopSpecialty
  created_at  DateTime          @default(now())

  workshop workshops @relation(fields: [workshop_id], references: [id])

  @@unique([workshop_id, specialty], name: "ux_workshop_specialty")
  @@index([workshop_id])
  @@map("workshop_specialties")
}

model users {
  id            Int          @id @default(autoincrement())
  email         String       @unique
  password_hash String
  role          WorkshopRole @default(STAFF)
  workshop_id   Int?
  is_active     Boolean      @default(true)
  last_login_at DateTime?
  created_at    DateTime     @default(now())
  updated_at    DateTime     @updatedAt

  workshop workshops? @relation(fields: [workshop_id], references: [id])

  @@index([workshop_id])
  @@map("users")
}

model workshop_plans {
  id                  Int      @id @default(autoincrement())
  workshop_id         Int      @unique
  monthly_query_limit Int?
  is_unlimited        Boolean  @default(false)
  notes               String?
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  workshop workshops @relation(fields: [workshop_id], references: [id])

  @@map("workshop_plans")
}

model workshop_query_usage {
  id            Int       @id @default(autoincrement())
  workshop_id   Int
  year_month    String
  query_count   Int       @default(0)
  rows_returned Int       @default(0)
  last_query_at DateTime?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  workshop workshops @relation(fields: [workshop_id], references: [id])

  @@unique([workshop_id, year_month], name: "ux_workshop_usage_month")
  @@index([workshop_id])
  @@map("workshop_query_usage")
}

model workshop_status {
  workshop_id       Int      @id
  is_verified_buyer Boolean  @default(false)
  is_active         Boolean  @default(true)
  onboarding_notes  String?
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  workshop workshops @relation(fields: [workshop_id], references: [id])

  @@map("workshop_status")
}
