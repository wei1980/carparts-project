generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

model AiPartDraft {
  id                String   @id
  userId            String?
  customerVehicleId String?
  query             String
  source_type       String
  source_url        String?
  raw_content       String?
  result_json       Json?
  status            String   @default("pending")
  created_at        DateTime @default(now())
  updated_at        DateTime @default(now())
    // Relations (for prisma include)
    user                         EndUser?                 @relation(fields: [userId], references: [id])
    customerVehicle              VehicleProfile?           @relation(fields: [customerVehicleId], references: [id])

  }

  model AuditLog {
  id         String   @id
  action     String
  entityType String
  entityId   String
  actorId    String?
  actorType  String?
  before     Json?
  after      Json?
  detail     Json?
  requestId  String?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([createdAt])
  @@index([entityType, entityId])
}

model BankRemittanceClaim {
  fingerprint     String   @id
  orderId         Int
  stage           String
  amount          Decimal  @db.Decimal(18, 2)
  transactionDate String
  last5           String?
  actorId         String
  createdAt       DateTime @default(now())

  // 分次匯款：同一訂單同一階段可認列多筆交易（合計金額由 advanceStatus 防重複推進保護）
  @@index([orderId])
}

model EndUser {
  id               String    @id
  passwordHash     String
  name             String?
  phone            String    @unique
  createdAt        DateTime  @default(now())
  lineId           String?
  is_approved      Boolean   @default(false)
  address          String?
  is_active        Boolean   @default(true)
  email            String?
  resetCodeExpires DateTime?
  resetCodeHash    String?
  currentVehicleId String?   @unique
  avatar_url       String?
  consumerOrders   ConsumerOrder[]
  aiPartDrafts     AiPartDraft[]
  appointments     Appointment[]
  wishItems        WishItem[]
}

model PartImageRecognitionLog {
  id              String   @id
  userId          String?
  imageUrl        String
  rawResult       Json
  finalBrand      String?
  finalModel      String?
  confidence      Float?
  confirmedByUser Boolean   @default(false)
  createdAt       DateTime  @default(now())
}

model SupportConversation {
  id            String           @id @default(cuid())
  code          String           @unique
  token         String
  customerName  String?
  customerPhone String?
  page          String?
  status        String           @default("OPEN")
  createdAt     DateTime         @default(now())
  messages      SupportMessage[]
}

model SupportMessage {
  id             String              @id @default(cuid())
  conversation   SupportConversation @relation(fields: [conversationId], references: [id])
  conversationId String
  direction      String
  author         String
  text           String
  createdAt      DateTime            @default(now())

  @@index([conversationId, createdAt])
}

model VehicleProfile {
  id            String   @id
  userId        String
  variantId     Int?
  vin           String?
  licensePlate  String?
  make          String?
  model         String?
  generation    String?
  year          Int?
  engine        String?
  modifications Json     @default("{}")

  // 🆕 里程數管理（工單自動回寫／手動／辨識／推算）
  current_mileage     Int?
  mileage_updated_at  DateTime?
  mileage_source      String?   // manual | ocr | garage | estimated
  mileage_source_note String?   // 例：「車大師旗艦廠工單」

  // Relations (for prisma include)
  variant                      VehicleVariant?           @relation(fields: [variantId], references: [id])
  modifications_detail         VehicleModification[]
  aiPartDrafts                 AiPartDraft[]
  appointments                 Appointment[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now())
  regPhotoUrl   String?

  @@index([id])
  @@index([userId])
  @@index([userId, variantId])
}

/// 註冊時車型庫找不到對應車型的紀錄（方案 A 配套）
/// 讓管理者知道哪些車型需要補進車型庫，補完可標記 RESOLVED。
model VehicleVariantRequest {
  @@map("vehicle_variant_requests")
  id            Int       @id @default(autoincrement())
  phone         String    @db.VarChar(20)
  make          String    @db.VarChar(60)
  model         String    @db.VarChar(80)
  year          Int?
  generation    String?   @db.VarChar(80)
  engine_code   String?   @db.VarChar(60)
  note          String?
  status        String    @default("PENDING") // PENDING | RESOLVED | DISMISSED
  request_count Int       @default(1)
  resolved_at   DateTime?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @default(now())

  @@index([status, created_at])
  @@index([make, model])
}

model WishItem {
  id              String     @id @default(uuid())
  userId          String
  description     String
  partPhoto       String?
  status          WishStatus @default(PENDING)
  handledBy       String?
  createdAt       DateTime   @default(now())
  notifiedAt      DateTime?
  partId          Int?
  targetPrice     Decimal?
  notifiedAtPrice Decimal?

  // Relations (for prisma include)
  user                         EndUser                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  part                         Part?                    @relation(fields: [partId], references: [id], onDelete: Cascade)

  @@index([partId])
  @@index([userId])
}

model Appointment {
  @@map("appointments")
  id            Int               @id @default(autoincrement())
  vehicle_id    String
  garage_id     Int
  user_id       String
  service_type  String?
  part_ids      Json?
  scheduled_at  DateTime
  status        AppointmentStatus @default(PENDING)
  note          String?
  created_at    DateTime          @default(now())
  updated_at    DateTime @default(now())
  install_items Json?
  proposed_at   DateTime?
  quote_amount  Int?
  quote_note    String?

  // 🆕 報價議價（客戶接受 / 還價）
  quote_accepted Boolean   @default(false)
  counter_amount Int?
  counter_note   String?
  countered_at   DateTime?

  @@index([garage_id])
  @@index([garage_id, scheduled_at])
  @@index([garage_id, status])
  @@index([status, scheduled_at])
  @@index([user_id])
  @@index([vehicle_id])
  @@index([vehicle_id, status])

  // Relations (for prisma include)
  vehicle                      VehicleProfile           @relation(fields: [vehicle_id], references: [id])
  garage                       Workshop                 @relation(fields: [garage_id], references: [id])
  user                         EndUser                  @relation(fields: [user_id], references: [id])
}

model BankTransaction {
  @@map("bank_transactions")
  id          Int      @id @default(autoincrement())
  date        String?
  amount      Float
  memo        String?
  remitter    String?
  row         Int
  fingerprint String?
  createdAt   DateTime @default(now())
}

model Bay {
  @@map("bays")
  id         Int      @id @default(autoincrement())
  garage_id  Int
  name       String
  code       String
  type       String   @default("STANDARD")
  is_active  Boolean  @default(true)
  sort_order Int      @default(0)
  created_at DateTime @default(now())
  updated_at DateTime @default(now())
  @@unique([garage_id, code])
}

model Categories {
  @@map("categories")
  id         Int     @id @default(autoincrement())
  name       String
  slug       String?
  parent_id  Int?
  sort_order Int     @default(0)
  is_active  Boolean @default(true)
  is_nav     Boolean @default(true)

  @@index([parent_id])

  // Relations (for prisma include)
  subcategories                Subcategories[]
  parts_on_categories          PartsOnCategories[]
}

model ConsumerOrderItem {
  @@map("consumer_order_items")
  id                 Int       @id @default(autoincrement())
  order_id           Int
  part_id            Int
  sku_snapshot       String
  name_snapshot      String
  price_snapshot     Decimal
  qty                Int
  is_preorder        Boolean   @default(false)
  promised_weeks     Int       @default(0)
  promised_weeks_min Int?
  promised_weeks_max Int?
  arrived_at         DateTime?
  shipped_at         DateTime?
  tracking_code      String?

  // Relations (for prisma include)
  order      ConsumerOrder     @relation(fields: [order_id], references: [id])
  part       Part             @relation(fields: [part_id], references: [id])
  returnItems OrderReturnItem[] // 🆕 退貨明細關聯

  @@index([order_id])
}

model ConsumerOrder {
  @@map("consumer_orders")
  id                        Int                 @id @default(autoincrement())
  order_number              String              @unique
  userId                    String
  status                    ConsumerOrderStatus @default(PENDING_PAYMENT)
  subtotal_amount           Decimal
  shipping_fee              Decimal             @default(0)
  tax_amount                Decimal             @default(0) // 🆕 稅金（5%，系統設定開啟時計入）
  total_amount              Decimal
  payment_last_5_digits     String?
  deposit_required          Boolean             @default(false)
  payment_method            String?
  cod_fee                   Decimal             @default(0)
  shipping_address          String
  tracking_number           String?
  created_at                DateTime            @default(now())
  updated_at                DateTime            @default(now())
  is_import_order           Boolean             @default(false)
  need_installation         Boolean             @default(false)
  note                      String?
  receiver_name             String
  receiver_phone            String
  vehicle_id                String?
  balanceAmount             Decimal?
  balancePaidAt             DateTime?
  bankDepositDate           DateTime?
  bankLastFiveDigits        String?
  bankRemitterName          String?
  bankDepositActualAmount   Decimal?   // 客戶實際匴款金額
  depositAmount             Decimal?
  depositPaidAt             DateTime?
  orderType                 ConsumerOrderType   @default(INSTOCK)
  shipped_at DateTime? // 🆕 記錄出貨時間
  issues OrderIssue[]  // 🆕 售後問題回報關聯
  returns OrderReturn[] // 🆕 退貨申請關聯
  trackingCodeDomestic      String?
  trackingCodeInternational String?
  domesticCarrierId         Int?      // 🆕 國內物流業者
  domesticCarrier           Carrier?  @relation(fields: [domesticCarrierId], references: [id])
  idempotency_key           String?             @unique
  // Relations (for prisma include)
  user                        EndUser             @relation(fields: [userId], references: [id])
  items                       ConsumerOrderItem[]

  @@index([created_at])
  @@index([status])
  @@index([userId])
  @@index([userId, status])
  @@index([vehicle_id])
}

// 🆕 物流業者（查貨網頁連結可由後台管理）
model Carrier {
  @@map("carriers")
  id          Int      @id @default(autoincrement())
  name        String             // 顯示名稱：新竹物流 / 郵局 / 7-11店到店 / 全家店到店
  code        String   @unique   // 短碼：HCT / POST / 711 / FAMILY
  trackingUrl String?            // 查貨網頁；含 {number} 會併入單號
  enabled     Boolean  @default(true)
  sort_order  Int      @default(0)
  created_at  DateTime @default(now())
  orders      ConsumerOrder[]
}

model GarageLaborFee {
  @@map("garage_labor_fees")
  id          Int      @id @default(autoincrement())
  workshop_id Int
  name        String
  price       Int
  note        String?
  sort_order  Int      @default(0)
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @default(now())
  @@index([workshop_id])
}

model GarageReview {
  @@map("garage_reviews")
  id             Int      @id @default(autoincrement())
  appointment_id Int      @unique
  garage_id      Int
  user_id        String
  rating         Int
  comment        String?
  created_at     DateTime @default(now())

  @@index([garage_id])
  @@index([user_id])
  @@index([garage_id], map: "idx_garage_review_garage")
}

model InsurancePolicy {
  @@map("insurance_policies")
  id            Int                   @id @default(autoincrement())
  user_id       String
  vehicle_id    String
  product_id    Int
  policy_number String?
  status        InsurancePolicyStatus @default(QUOTED)
  premium       Decimal               @default(0)
  start_date    DateTime?
  end_date      DateTime?
  created_at    DateTime              @default(now())
  updated_at    DateTime @default(now())
  @@index([user_id])
  @@index([vehicle_id])
}

model InsuranceProduct {
  @@map("insurance_products")
  id           Int      @id @default(autoincrement())
  name         String
  insurer_name String
  coverage     Json?
  base_premium Decimal  @default(0)
  is_active    Boolean  @default(false)
  created_at   DateTime @default(now())
}

model InventoryLog {
  @@map("inventory_logs")
  id         Int      @id @default(autoincrement())
  part_id    Int
  qty_change Int
  qty_after  Int
  type       String
  note       String?
  created_at DateTime @default(now())

  @@index([created_at])
  @@index([part_id, created_at])
  @@index([part_id])
  @@index([type])

  // Relations (for prisma include)
  part                         Part                     @relation(fields: [part_id], references: [id])
}

model MaintenanceReminder {
  @@map("maintenance_reminders")
  id               Int       @id @default(autoincrement())
  user_id          String
  vehicle_id       String
  title            String
  interval_km      Int?
  interval_days    Int?
  base_mileage     Int?
  due_date         DateTime?
  source           String    @default("MANUAL")
  enabled          Boolean   @default(true)
  last_notified_at DateTime?
  created_at       DateTime  @default(now())
  updated_at       DateTime @default(now())
  @@index([due_date])
  @@index([enabled])
  @@index([user_id, enabled])
  @@index([user_id])
  @@index([vehicle_id, enabled])
  @@index([vehicle_id])
}

model OrderItem {
  @@map("order_items")
  id                 Int     @id @default(autoincrement())
  order_id           Int
  part_id            Int
  sku_snapshot       String
  name_snapshot      String
  price_snapshot     Decimal
  qty                Int
  is_preorder        Boolean @default(false)
  promised_weeks     Int     @default(0)
  promised_weeks_min Int?
  promised_weeks_max Int?

  @@index([order_id])

  order Order @relation(fields: [order_id], references: [id])
}

model Order {
  @@map("orders")
  id                    Int         @id @default(autoincrement())
  order_number          String      @unique
  workshop_id           Int
  status                OrderStatus @default(PENDING_PAYMENT)
  subtotal_amount       Decimal
  shipping_fee          Decimal     @default(0)
  total_amount          Decimal
  payment_last_5_digits String?
  deposit_required      Boolean     @default(false)
  shipping_address      String
  tracking_number       String?
  created_at            DateTime    @default(now())
  updated_at            DateTime    @default(now())
  // Relations (for prisma include)
  workshop                     Workshop                 @relation(fields: [workshop_id], references: [id])
  items                        OrderItem[]
}

model PartCaliperFitment {
  @@map("part_caliper_fitment")
  id         Int @id @default(autoincrement())
  pad_id     Int
  caliper_id Int

  @@unique([pad_id, caliper_id])
  @@index([caliper_id])
}

model PartModificationFitment {
  @@map("part_modification_fitments")
  id               Int      @id @default(autoincrement())
  modificationType String
  modPartId        Int
  targetPartId     Int
  fitmentRule      Json
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime

  @@unique([modificationType, modPartId, targetPartId])
  @@index([modPartId])
  @@index([targetPartId])
}

model PartCompatibility {
  @@map("part_vehicle_compatibility")
  id         Int @id @default(autoincrement())
  part_id    Int
  vehicle_id Int

  @@unique([part_id, vehicle_id])
  @@index([vehicle_id], map: "idx_part_compat_vehicle")
  @@index([vehicle_id])

  // Relations (for prisma include)
  part                         Part                     @relation(fields: [part_id], references: [id])
  vehicle                      VehicleVariant           @relation(fields: [vehicle_id], references: [id])
}

model Part {
  @@map("parts")
  id                      Int            @id @default(autoincrement())
  sku                     String         @unique
  name                    String
  brand                   String
  subcategory_id          Int?
  category                String?
  image_url               String?
  description             String?
  specs                   Json?
  msrp_price              Decimal        @default(0)
  wholesale_price         Decimal        @default(0)
  stock_qty               Int            @default(0)
  preorder_lead_time_days Int            @default(21)
  is_active               Boolean        @default(true)
  created_at              DateTime       @default(now())
  updated_at              DateTime       @default(now())
  stock_location          StockLocation?
  is_universal            Boolean        @default(false)
  sales_count             Int            @default(0)
  view_count              Int            @default(0)
  distributor_stock_qty   Int            @default(0)
  is_official             Boolean        @default(false)
  orderItems              ConsumerOrderItem[]
  wishItems               WishItem[]

  @@index([sales_count])
  @@index([subcategory_id])
  @@index([view_count])

  // Relations (for prisma include)
  subcategory                  Subcategories?            @relation(fields: [subcategory_id], references: [id])
  parts_on_categories          PartsOnCategories[]
  compatible_vehicles          PartCompatibility[]
  inventoryLogs                InventoryLog[]
  shipmentItems                ShipmentItem[]
}

model PartsOnCategories {
  @@map("parts_on_categories")
  part_id     Int
  category_id Int

  @@id([part_id, category_id])
  @@index([category_id])
  @@index([part_id])

  // Relations (for prisma include)
  part                         Part                     @relation(fields: [part_id], references: [id])
  category                     Categories               @relation(fields: [category_id], references: [id])
}

model PurchaseOrderItem {
  @@map("purchase_order_items")
  id                Int     @id @default(autoincrement())
  purchase_order_id Int
  part_id           Int
  sku_snapshot      String
  name_snapshot     String
  brand_snapshot    String?
  price_snapshot    Decimal
  qty               Int     @default(1)
  is_preorder       Boolean @default(false)

  @@index([purchase_order_id])
}

model PurchaseOrder {
  @@map("purchase_orders")
  id               Int                 @id @default(autoincrement())
  po_number        String              @unique
  workshop_id      Int
  status           PurchaseOrderStatus @default(SUBMITTED)
  total_amount     Decimal             @default(0)
  note             String?
  contact_name     String?
  contact_phone    String?
  shipping_address String?
  confirmed_at     DateTime?
  shipped_at       DateTime?
  completed_at     DateTime?
  cancelled_at     DateTime?
  cancel_reason    String?
  created_at       DateTime            @default(now())
  updated_at       DateTime @default(now())
  @@index([status])
  @@index([workshop_id])
}

model ServiceRecordItem {
  @@map("service_record_items")
  id         Int             @id @default(autoincrement())
  record_id  Int
  record     ServiceRecord   @relation(fields: [record_id], references: [id], onDelete: Cascade)
  kind       ServiceItemKind
  name       String
  part_sku   String?
  part_brand String?
  quantity   Int             @default(1)
  unit_price Int             @default(0)
  note       String?
}

model ServiceRecord {
  @@map("service_records")
  id             Int                 @id @default(autoincrement())
  vehicle_id     String
  user_id        String
  garage_id      Int
  appointment_id Int?
  mileage_km     Int?
  status         ServiceRecordStatus @default(DRAFT)
  summary        String?
  total_amount   Int                 @default(0)
  completed_at   DateTime?
  created_at     DateTime            @default(now())
  updated_at     DateTime @default(now())
  items          ServiceRecordItem[]
  @@index([garage_id])
  @@index([garage_id, status])
  @@index([user_id])
  @@index([vehicle_id, completed_at])
  @@index([vehicle_id])
  @@index([vehicle_id, status])
}

model ShipmentItem {
  @@map("shipment_items")
  id               Int      @id @default(autoincrement())
  shipment_id      Int
  part_id          Int
  qty              Int
  unit_price_twd   Decimal
  landed_unit_cost Decimal?
  shipment         Shipment @relation(fields: [shipment_id], references: [id])
  part             Part     @relation(fields: [part_id], references: [id])

  @@index([part_id])
  @@index([shipment_id])
}

model Shipment {
  @@map("shipments")
  id                Int            @id @default(autoincrement())
  shipment_no       String         @unique
  type              ShipmentType   @default(IMPORT)
  status            ShipmentStatus @default(DRAFT)
  supplier_id       Int
  currency          String         @default("USD")
  exchange_rate     Decimal        @default(1)
  goods_cost_twd    Decimal        @default(0)
  intl_freight_twd  Decimal        @default(0)
  local_freight_twd Decimal        @default(0)
  customs_duty_twd  Decimal        @default(0)
  customs_other_twd Decimal        @default(0)
  paid_amount_twd   Decimal        @default(0)
  allocation_method String         @default("BY_AMOUNT")
  ordered_at        DateTime?
  eta_date          DateTime?
  received_at       DateTime?
  note              String?
  created_at        DateTime       @default(now())
  updated_at        DateTime       @default(now())
  supplier          Supplier       @relation(fields: [supplier_id], references: [id])
  items             ShipmentItem[]
}

model Subcategories {
  @@map("subcategories")
  id          Int     @id @default(autoincrement())
  category_id Int
  name        String
  sort_order  Int     @default(0)
  is_active   Boolean @default(true)

  @@index([category_id])

  // Relations (for prisma include)
  category                     Categories               @relation(fields: [category_id], references: [id])
  parts                        Part[]
}

model Supplier {
  @@map("suppliers")
  id             Int      @id @default(autoincrement())
  name           String
  country        String?
  contact_person String?
  phone          String?
  email          String?
  payment_terms  String?
  currency       String   @default("USD")
  note           String?
  is_active      Boolean  @default(true)
  created_at     DateTime @default(now())
  updated_at     DateTime @default(now())
  shipments      Shipment[]
}

model VehicleModification {
  @@map("vehicle_modifications")
  id                 String    @id
  vehicleId          String
  category           String
  partType           String
  brand              String
  model              String
  specJson           Json?
  installedAt        DateTime?
  installedMileageKm Int?
  laborCost          Int?
  warrantyUntil      DateTime?
  garageId           Int?
  beforePhotoUrls    Json?
  afterPhotoUrls     Json?
  note               String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime

  @@index([category, partType])
  @@index([vehicleId])

  // Relations (for prisma include)
  vehicle                      VehicleProfile           @relation(fields: [vehicleId], references: [id])
}

model VehicleVariant {
  @@map("vehicle_variants")
  id           Int     @id @default(autoincrement())
  make         String
  model        String
  generation   String
  engine_code  String
  variant_name String
  specs        Json?
  year_start   Int
  year_end     Int
  is_approved  Boolean @default(true)
  drive_type   String?

  @@index([make, model, generation, year_start])

  // Relations (for prisma include)
  vehicleProfiles   VehicleProfile[]
  compatibleParts   PartCompatibility[]
  brakePartFitments BrakePartFitment[]
}

model WorkOrderItem {
  @@map("work_order_items")
  id            Int      @id @default(autoincrement())
  work_order_id Int
  part_id       Int
  name          String
  quantity      Int      @default(1)
  unit_price    Decimal  @default(0)
  type          String   @default("PART")
  created_at    DateTime @default(now())
  updated_at    DateTime @default(now())
  @@index([part_id])
  @@index([work_order_id])
}

model WorkOrderLaborItem {
  @@map("work_order_labor_items")
  id            Int      @id @default(autoincrement())
  work_order_id Int
  labor_fee_id  Int?
  name          String
  amount        Decimal  @default(0)
  description   String?
  type          String   @default("LABOR")
  created_at    DateTime @default(now())
  updated_at    DateTime @default(now())
  @@index([work_order_id])
}

model WorkOrderStatusHistory {
  @@map("work_order_status_history")
  id            Int             @id @default(autoincrement())
  work_order_id Int
  from_status   WorkOrderStatus
  to_status     WorkOrderStatus
  note          String?
  changed_by    String?
  created_at    DateTime        @default(now())

  @@index([work_order_id])
}

model OrderIssue {
  id          Int      @id @default(autoincrement())
  orderId     Int
  orderItemId Int?
  issueType   String   // 'DEFECT' 或 'MISMATCH'
  description String
  mediaUrls   String[] // 存放檔案路徑陣列
  adminNotes  Json?    // 🆕 管理員處理紀錄（JSON 陣列，每筆為 { at, by, byName, text }）
  status      String   @default("REPORTED") // 售後流程：REPORTED(已回報) → PROCESSING(客服處理中) → RESOLVED(結案)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // 關聯到訂單
  order ConsumerOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_issues")
}

// 🆕 退貨申請
model OrderReturn {
  id                Int          @id @default(autoincrement())
  orderId           Int
  orderItemId       Int?              // null = 整單退貨
  returnReason      String            // DEFECT / MISMATCH / CHANGE_MIND / OTHER
  description       String
  mediaUrls         String[]
  status            ReturnStatus @default(PENDING)
  refundAmount      Decimal?          // 退款金額（管理端核可時確認）
  returnShippingFee Decimal          @default(0) // 🆕 退貨運費（客戶負擔金額；瑕疵/規格不符為 0）
  isExchange        Boolean          @default(false) // 🆕 是否換貨（換貨不退款，改寄新品）
  exchangeTrackingCode String?            // 🆕 換貨出貨單號
  exchangeShippedAt  DateTime?            // 🆕 換貨出貨時間
  refundBankCode    String?           // 退款銀行代碼（客戶填寫）
  refundAccount     String?           // 退款帳號（客戶填寫）
  refundAccountName String?           // 退款戶名（客戶填寫）
  adminNotes        Json?             // 處理紀錄（JSON 陣列，每筆為 { at, by, byName, text }）
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  resolvedAt        DateTime?

  // 關聯到訂單
  order ConsumerOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items OrderReturnItem[] // 🆕 退貨商品明細（勾選商品與數量）

  @@index([orderId])
  @@index([status])
  @@map("order_returns")
}

// 🆕 退貨商品明細（多商品部分退貨：勾選商品 × 數量）
model OrderReturnItem {
  id          Int       @id @default(autoincrement())
  returnId    Int
  orderItemId Int
  qty         Int       // 退貨數量（≤ 購買數量）
  price       Decimal   @db.Decimal(65, 30) // 退貨時單價快照
  createdAt   DateTime  @default(now())

  orderItem   ConsumerOrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  orderReturn OrderReturn        @relation(fields: [returnId], references: [id], onDelete: Cascade)

  @@index([returnId])
  @@index([orderItemId])
  @@map("order_return_items")
}

model WorkOrder {
  @@map("work_orders")
  id                   Int             @id @default(autoincrement())
  garage_id            Int
  vehicle_id           String
  user_id              String?
  technician_id        String?
  bay_id               Int?
  appointment_id       Int?            @unique
  service_type         String          @default("REPAIR")
  status               WorkOrderStatus @default(RECEIVED)
  initial_notes        String?
  estimated_completion DateTime?
  quote_amount         Int?
  quote_note           String?
  quote_valid_until    DateTime?
  quote_sent_at        DateTime?
  completed_at         DateTime?
  delivered_at         DateTime?
  photos               String?
  created_at           DateTime        @default(now())
  updated_at           DateTime @default(now())
  @@index([garage_id, created_at])
  @@index([garage_id])
  @@index([garage_id, status])
  @@index([status])
  @@index([technician_id])
  @@index([user_id])
  @@index([vehicle_id])
  @@index([vehicle_id, status])
}

model WorkshopCustomerVisit {
  @@map("workshop_customer_visits")
  id           Int      @id @default(autoincrement())
  customer_id  Int
  workshop_id  Int
  status       String
  service_type String?
  summary      String?
  total_amount Int      @default(0)
  created_at   DateTime @default(now())

  @@index([customer_id])
  @@index([workshop_id])
}

model WorkshopCustomer {
  @@map("workshop_customers")
  id          Int       @id @default(autoincrement())
  workshop_id Int
  name        String
  phone       String
  line_id     String?
  tags        String[]  @default([])
  note        String?
  visit_count Int       @default(0)
  last_visit  DateTime?
  created_at  DateTime  @default(now())
  updated_at  DateTime @default(now())
  @@unique([workshop_id, phone])
  @@index([workshop_id], map: "idx_workshop_customer_workshop")
  @@index([workshop_id])
}

model WorkshopQueryUsage {
  @@map("workshop_query_usage")
  id            Int       @id @default(autoincrement())
  workshop_id   Int
  year_month    String
  query_count   Int       @default(0)
  rows_returned Int       @default(0)
  last_query_at DateTime? @default(now())
  updated_at    DateTime @default(now())
  @@unique([workshop_id, year_month])
}

model Workshop {
  @@map("workshops")
  id             Int          @id @default(autoincrement())
  email          String       @unique
  password_hash  String
  company_name   String
  tax_id         String?
  line_id        String
  contact_person String
  job_title      String?
  phone          String
  address        String
  shop_type      String?
  role           WorkshopRole @default(TRIAL)
  is_approved    Boolean      @default(false)
  is_active      Boolean      @default(true)
  created_at     DateTime     @default(now())
  updated_at     DateTime @default(now())
  garage_address String?
  garage_name    String?
  garage_phone   String?
  garage_slots   Json?
  is_garage      Boolean      @default(false)
  lat            Float?
  lng            Float?
  rating         Float        @default(5.0)
  review_count   Int          @default(0)
  garage_photos  Json?
  opening_hours  Json?
  orders           Order[]
  appointments     Appointment[]
