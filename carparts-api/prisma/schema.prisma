// ========== 煞車件資料模型（可套用所有廠牌）==========
// 設計參考：media/Data/煞車零件關係表設計.md
// 既有 5 張表（2026-10-20 之前以 raw SQL 建立），此處手寫模型對應實際欄位，
// 不可用 prisma db pull --force（會摧毀整個 schema）。

/// 煞車件主檔：來令片 / 碟盤，跨廠牌共用同一張表
model BrakePart {
  @@map("brake_parts")
  id             Int      @id @default(autoincrement())
  brand          String
  sku            String
  /// 'pad' | 'disc'
  part_type      String
  /// 等級/系列: Prime / Xtra / Greenstuff 2000 / Yellowstuff / COATED DISC LINE
  product_line   String?
  /// 'front' | 'rear' | 'both'
  position       String?
  name           String
  name_zh        String?
  description    String?
  /// FMSI 編號（用來比對同規格不同品牌）
  fmsi           String?
  /// WVA 編號（歐洲標準碼）
  wva_number     String?
  ean            String?
  /// Premium / Standard / Economy
  brand_class    String?
  price_eur      Decimal? @db.Decimal(10, 2)
  image_url      String?
  is_active      Boolean  @default(true)
  created_at     DateTime @default(now()) @db.Timestamptz(3)
  updated_at     DateTime @default(now()) @db.Timestamptz(3)
  price_msrp     Int?
  price_wholesale Int?

  specs          BrakePartSpec[]
  fitments       BrakePartFitment[]
  oeNumbers      BrakePartOe[]
  specGroups     BrakePartSpecGroup[]

  @@unique([brand, sku])
  @@index([part_type])
  @@index([brand, product_line])
  @@index([fmsi])
  @@index([wva_number])
}

/// 原廠料號對照（多對多）—— 一顆 Brembo 來令片對應 AUDI 80 個、VW 78 個…競品料號
model BrakePartOe {
  @@map("brake_part_oe")
  id            Int    @id @default(autoincrement())
  brake_part_id Int
  oe_brand      String
  oe_number     String
  /// 'oe'(原廠) | 'fmsi' | 'wva' | 'trade' | 'competitor' | 'accessory'
  oe_kind       String @default("oe")

  brakePart BrakePart @relation(fields: [brake_part_id], references: [id], onDelete: Cascade)

  @@unique([brake_part_id, oe_brand, oe_number, oe_kind])
  @@index([oe_number])
  @@index([brake_part_id])
}

/// 零件 × 車型 適用關係（EBC 來令片車型關係表.csv 的正規化版本）
model BrakePartFitment {
  @@map("brake_part_fitment")
  id                Int      @id @default(autoincrement())
  brake_part_id     Int
  /// 對應本站車型庫；供應商資料常只到 make+model 層級，此時留 NULL
  vehicle_id        Int?
  make              String
  model             String
  generation        String?
  engine            String?
  displacement_cc   Int?
  bhp_ps            Int?
  fuel              String?
  year_start        Int?
  year_end          Int?
  year_raw          String?
  position          String?
  disc_diameter_mm  Int?
  disc_thickness_mm Int?
  disc_style        String?
  caliper_make      String?
  source            String?
  /// 'exact' | 'model' | 'family' | 'manual'
  confidence        String?
  created_at        DateTime @default(now()) @db.Timestamptz(3)

  brakePart BrakePart @relation(fields: [brake_part_id], references: [id], onDelete: Cascade)
  vehicle   VehicleVariant? @relation(fields: [vehicle_id], references: [id], onDelete: Cascade)

  @@unique([brake_part_id, make, model, generation, engine, year_start, year_end, position])
  @@index([brake_part_id])
  @@index([vehicle_id])
  @@index([make, model])
  @@index([make, model, year_start, year_end])
}

/// 零件的多值規格（3,200/330/360mm 三種碟徑等）
model BrakePartSpec {
  @@map("brake_part_spec")
  id            Int      @id @default(autoincrement())
  brake_part_id Int
  spec_key      String
  spec_value    String
  num_value     Decimal? @db.Decimal(12, 3)
  unit          String?

  brakePart BrakePart @relation(fields: [brake_part_id], references: [id], onDelete: Cascade)

  @@unique([brake_part_id, spec_key, spec_value])
  @@index([spec_key, spec_value])
}

/// **共用規格群組** —— 跨廠牌對應的共同鍵。
///
/// 同一組物理規格（位置 + 碟徑 + 碟厚 + 碟型 + 卡鉗）只會有一筆，
/// 不同廠牌的零件只要規格相同就會連到同一筆，
/// 因此可由「這個零件」查到「其他廠牌的對應零件」。
///
/// 規格來源：
///   - 來令片：由 brake_part_fitment 的 disc_diameter_mm / disc_thickness_mm /
///             disc_style / caliper_make 彙整
///   - 碟盤：由碟盤自身的直徑/厚度/通風方式/卡鉗
model BrakeSpec {
  @@map("brake_spec")
  id                Int      @id @default(autoincrement())
  /// 正規化後的規格鍵（位置+直徑+厚度+碟型+卡鉗），跨廠牌一致
  spec_key          String   @unique
  position          String?
  disc_diameter_mm  Int?
  disc_thickness_mm Int?
  disc_style        String?
  caliper_make      String?
  /// 人可讀的規格描述，例如「前輪 330mm 通風碟 ×20mm ATE」
  display_name      String?
  created_at        DateTime @default(now()) @db.Timestamptz(3)

  parts BrakePartSpecGroup[]

  @@index([position, disc_diameter_mm])
  @@index([disc_diameter_mm, disc_thickness_mm])
  @@index([caliper_make])
}

/// 零件 ↔ 共用規格群組（多對多：一顆來令片可對應多組碟規格）
model BrakePartSpecGroup {
  @@map("brake_part_spec_group")
  id            Int @id @default(autoincrement())
  brake_part_id Int
  brake_spec_id Int

  brakePart BrakePart @relation(fields: [brake_part_id], references: [id], onDelete: Cascade)
  brakeSpec BrakeSpec @relation(fields: [brake_spec_id], references: [id], onDelete: Cascade)

  @@unique([brake_part_id, brake_spec_id])
  @@index([brake_spec_id])
}

/// 供應商來源稽核：每個廠牌從哪抓、什麼時候、幾筆
model BrakeSupplierSource {
  @@map("brake_supplier_sources")
  id          Int      @id @default(autoincrement())
  brand       String
  source      String
  source_url  String?
  fetched_at  DateTime @default(now()) @db.Timestamptz(3)
  item_count  Int?
  note        String?
}
